{
    "name": "cenef/touche-pas-au-klaxon",
    "description": "Application de covoiturage inter-sites",
    "type": "project",
    "require": {
        "php": "^8.1",
        "izniburak/router": "^3.1",
        "vlucas/phpdotenv": "^5.7"
    },
    "authors": [
        {
            "name": "JivannSo",
            "email": "jisoart@gmail.com"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "phpstan/phpstan": "^2.3",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "lint": "phpcs"
    }
}
