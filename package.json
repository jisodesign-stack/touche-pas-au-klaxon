{
  "name": "touche-pas-au-klaxon",
  "version": "1.0.0",
  "description": "Assets front (Bootstrap + Sass) de l'application Touche pas au klaxon",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build:css": "sass --load-path=node_modules --quiet-deps --silence-deprecation=import,global-builtin,color-functions --style=compressed --no-source-map scss/app.scss public/css/app.css",
    "build:assets": "node scripts/copy-assets.mjs",
    "build": "npm run build:css && npm run build:assets",
    "watch": "sass --load-path=node_modules --quiet-deps --silence-deprecation=import,global-builtin,color-functions --watch scss/app.scss public/css/app.css"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "sass": "^1.105.1"
  }
}
